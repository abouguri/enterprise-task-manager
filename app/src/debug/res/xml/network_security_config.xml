<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-build-only (src/debug/, not src/main/) - release builds get Android's default
     HTTPS-only behavior untouched. Permits cleartext HTTP only to 10.0.2.2, the emulator's
     special alias for the host machine's loopback, for hitting the local dev backend. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
